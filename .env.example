# # CompreFace subject/collection name (create this in CompreFace UI first)


# # PostgreSQL Configuration (for API)
# # Use DATABASE_URL if provided, otherwise build from POSTGRES_* values

# # CompreFace Configuration
# # CompreFace API is accessible at compreface-api:3000 within Docker network
# # Get API key from CompreFace UI at http://localhost:8001 after setup

# # CompreFace subject/collection name (create this in CompreFace UI first)

# # CompreFace Docker Image Registry

# # CompreFace PostgreSQL Configuration

# # CompreFace Email Configuration (optional)

# # CompreFace Settings

# # CompreFace Version Tags

# # Backend Configuration

# # Storage Configuration

# # API Security

# # JWT Configuration

# # Google Maps API (for frontend)

# # WebSocket Configuration


# # Admin Default User (for initial setup)


# PostgreSQL Configuration (for API)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
# Use DATABASE_URL if provided, otherwise build from POSTGRES_* values
DATABASE_URL=
COMPREFACE_VERIFICATION_KEY=
COMPREFACE_RECOGNITION_KEY=
COMPREFACE_DETECTION_KEY=
# CompreFace Configuration
# CompreFace API is accessible at compreface-api:3000 within Docker network
# Get API key from CompreFace UI at http://localhost:8001 after setup
COMPREFACE_URL=
COMPREFACE_API_KEY=
# CompreFace subject/collection name (create this in CompreFace UI first)
COMPREFACE_SUBJECT=

# CompreFace Docker Image Registry
registry=

# CompreFace PostgreSQL Configuration
postgres_username=
postgres_password=
postgres_db=
postgres_domain=
postgres_port=

# CompreFace Email Configuration (optional)
email_host=
email_username=
email_from=
email_password=
enable_email_server=

# CompreFace Settings
save_images_to_db=
compreface_api_java_options=
compreface_admin_java_options=
max_file_size=
max_request_size=
max_detect_size=
uwsgi_processes=
uwsgi_threads=
connection_timeout=
read_timeout=

# CompreFace Version Tags
ADMIN_VERSION=
API_VERSION=
FE_VERSION=
CORE_VERSION=
POSTGRES_VERSION=

# Backend Configuration
BACKEND_HOST=
BACKEND_PORT=
SECRET_KEY=

# Storage Configuration
STORAGE_PATH=

# API Security
CAMERA_API_KEY=

# JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_EXPIRATION_HOURS=

# System User (Default Admin)
SYSTEM_USER_USERNAME=
SYSTEM_USER_PASSWORD=
SYSTEM_USER_EMAIL=

# External API Configuration
EXTERNAL_API_URL=
EXTERNAL_API_KEY=

WEB_PORT=
