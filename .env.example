
# Use DATABASE_URL if provided, otherwise build from POSTGRES_* values
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/facesdb

# CompreFace Configuration
# CompreFace API is accessible at compreface-api:3000 within Docker network
# Get API keys from CompreFace UI at http://localhost:8001 after setup
# Each service (Verification, Recognition, Detection) requires its own API key
COMPREFACE_URL=http://compreface-fe:8001
COMPREFACE_VERIFICATION_KEY=
COMPREFACE_RECOGNITION_KEY=
COMPREFACE_DETECTION_KEY=
# CompreFace subject/collection name (create this in CompreFace UI first)


# PostgreSQL Configuration (for API)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=facesdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Use DATABASE_URL if provided, otherwise build from POSTGRES_* values
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/facesdb

# CompreFace Configuration
# CompreFace API is accessible at compreface-api:3000 within Docker network
# Get API key from CompreFace UI at http://localhost:8001 after setup

# CompreFace subject/collection name (create this in CompreFace UI first)
COMPREFACE_SUBJECT=

# CompreFace Docker Image Registry
registry=exadel/

# CompreFace PostgreSQL Configuration
postgres_username=postgres
postgres_password=postgres
postgres_db=frs
postgres_domain=compreface-postgres-db
postgres_port=5432

# CompreFace Email Configuration (optional)
email_host=smtp.gmail.com
email_username=
email_from=
email_password=
enable_email_server=false

# CompreFace Settings
save_images_to_db=true
compreface_api_java_options=-Xmx4g
compreface_admin_java_options=-Xmx1g
max_file_size=5MB
max_request_size=10M
max_detect_size=640
uwsgi_processes=2
uwsgi_threads=1
connection_timeout=10000
read_timeout=60000

# CompreFace Version Tags
ADMIN_VERSION=1.2.0
API_VERSION=1.2.0
FE_VERSION=1.2.0
CORE_VERSION=1.2.0
POSTGRES_VERSION=1.2.0

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=verysecret

# Storage Configuration
STORAGE_PATH=/data/storage

# API Security
CAMERA_API_KEY=changeme_camera_api_key
GPS_DEVICE_API_KEY=

# JWT Configuration
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# Google Maps API (for frontend)
VITE_GOOGLE_MAPS_API_KEY=

# WebSocket Configuration
WEBSOCKET_ENABLED=

WEB_PORT=3122

# Admin Default User (for initial setup)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=